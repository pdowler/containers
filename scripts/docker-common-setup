#!/bin/bash

BASE=$(git rev-parse --show-toplevel)

echo "import common config..."
if [[ "$1" == "SRC" ]]; then
  CF=$BASE/src-config
else
  CF=$BASE/config
fi
rsync -avuc $CF/ config/

echo "local haproxy setup..."
HAP=$(grep haproxy /etc/hosts | awk '{print $2}')
HAPIP=$(grep haproxy /etc/hosts | awk '{print $1}')
echo "$HAP -> $HAPIP"
export HAP HAPIP

if [ "$1" == "nosecrets" ]; then
  exit 0
fi

echo "import secrets..."
\cp ~/work/etc/RsaSignaturePub.key config/
\cp ~/work/test-certificates/servops.pem config/cadcproxy.pem

