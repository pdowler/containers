#!/bin/bash

SELF=$(basename $(pwd))
IMG="bifrost:latest"

. $HOME/bin/docker-common-setup

. $HOME/work/bin/docker-static-ip $SELF

PG=caom2db
PGIP=$(docker-find-ip $PG)

CMD="docker run --rm --user tomcat:tomcat \
	--network=$DOCKER_NET --ip=$DOCKER_STATIC_IP \
	--add-host $HAP:$HAPIP \
    	--add-host $PG:$PGIP \
	--volume=$(pwd)/config:/config:ro \
        --name $SELF $SELF:latest"

echo $CMD

$CMD >& tomcat.log &

if [ "$1" = "-f" ]; then
    exec tail -100f tomcat.log
fi

