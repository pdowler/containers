#!/bin/bash

SELF=$(basename $(pwd))
IMG=icewind:latest

. $HOME/bin/docker-common-setup

. $HOME/bin/docker-static-ip $SELF

\rm -f config/cadcproxy.pem
\cp $HOME/.ssl/cadcproxy.pem config/

PG=caom2syncdb
PGIP=$(docker-find-ip $PG)

CMD="docker run --rm --user opencadc:opencadc \
	--add-host $PG:$PGIP \
	--add-host $HAP:$HAPIP \
	--volume=$(pwd)/config:/config:ro \
	--name  $SELF $IMG"

echo $CMD

$CMD

