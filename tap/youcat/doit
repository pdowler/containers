#!/bin/bash

SELF=$(basename $(pwd))
IMG="youcat:vosi-permissions"
#IMG="images.opencadc.org/core/youcat:0.9.5"

. $HOME/bin/docker-common-setup

. $HOME/bin/docker-static-ip $SELF

\cp ~/work/test-certificates/tmpops.pem config/tmpops.pem

PG=youcatdb
PGIP=$(docker-find-ip $PG)

CMD="docker run --rm --user tomcat:tomcat \
	--network=$DOCKER_NET --ip=$DOCKER_STATIC_IP \
	--add-host $HAP:$HAPIP \
        --env tomcat.connector.proxyName=$HAP \
        --add-host $PG:$PGIP \
	--volume=$(pwd)/config:/config:ro \
        --name $SELF $IMG"

echo $CMD

$CMD >& tomcat.log &

if [ "$1" = "-f" ]; then
    exec tail -100f tomcat.log
fi

